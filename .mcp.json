{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "mantine": {
            "command": "npx",
            "args": [
                "-y",
                "@mantine/mcp-server"
            ]
        }
    }
}